{
  "name": "terminai-website",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "predev": "npm run recipes:validate && npm run updates:validate && npm run i18n:validate && npm run docs:api && npm run docs:search-index",
    "build": "next build",
    "prebuild": "npm run recipes:validate && npm run updates:validate && npm run i18n:validate && npm run docs:api && npm run docs:search-index",
    "start": "next start",
    "lint": "eslint",
    "docs:api": "node scripts/generate_api_reference.mjs",
    "docs:search-index": "node scripts/build_docs_search_index.mjs",
    "i18n:validate": "node scripts/validate_locales.mjs",
    "recipes:validate": "node scripts/validate_recipes.mjs",
    "updates:validate": "node scripts/validate_updates.mjs",
    "perf:ci": "lhci autorun --config=./lighthouserc.cjs",
    "test:e2e": "playwright test tests/e2e/smoke.spec.ts",
    "test:visual": "playwright test tests/e2e/visual.spec.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "framer-motion": "^12.23.26",
    "geist": "^1.5.1",
    "gray-matter": "^4.0.3",
    "lucide-react": "^0.562.0",
    "next": "16.1.0",
    "next-mdx-remote": "^5.0.0",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "shiki": "^3.20.0"
  },
  "devDependencies": {
    "@lhci/cli": "^0.15.1",
    "@playwright/test": "^1.57.0",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "babel-plugin-react-compiler": "1.0.0",
    "cheerio": "^1.1.2",
    "eslint": "^9",
    "eslint-config-next": "16.1.0",
    "tailwindcss": "^4",
    "turndown": "^7.2.2",
    "typescript": "^5"
  }
}
